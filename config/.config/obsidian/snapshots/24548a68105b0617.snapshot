14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\"></path><path d=\"M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z\"></path></svg></div><div class=\"pdf-plus-color-palette-status-container\"><span class=\"pdf-plus-color-palette-status\"></span></div></div></div><div class=\"pdf-toolbar-right\"></div></div><div class=\"pdf-container\"><div class=\"pdf-content-container node-insert-event\"><div class=\"pdf-viewer-container\" style=\"position: absolute;;opacity:0\"><div class=\"pdfViewer\" style=\"--scale-factor: 2.5825615043147234;\" lang=\"en\"><div class=\"page\" data-page-number=\"1\" role=\"region\" data-l10n-id=\"pdfjs-page-landmark\" data-l10n-args=\"{&quot;page&quot;:1}\" style=\"width: round(down, var(--total-scale-factor) * 595.91998px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 842.88px, var(--scale-round-y));\" data-loaded=\"true\"><div class=\"canvasWrapper\"><canvas role=\"presentation\" width=\"1539\" height=\"2176\"></canvas></div><div tabindex=\"0\" class=\"textLayer\" data-main-rotation=\"0\" style=\"width: round(down, var(--total-scale-factor) * 595.91998px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 842.88px, var(--scale-round-y));\"><span class=\"markedContent\" id=\"undefined\"></span><span class=\"markedContent\" id=\"p2R_mc0\"><span data-idx=\"0\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *45.75px); top: calc(var(--total-scale-factor) *54.61px); font-size: calc(var(--total-scale-factor) *24.00px); font-family: sans-serif; transform: scaleX(1.01688);\">Roadmap Bachelorarbeit: Synthetische Risse</span><br role=\"presentation\"><span data-idx=\"1\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *45.75px); top: calc(var(--total-scale-factor) *83.11px); font-size: calc(var(--total-scale-factor) *24.00px); font-family: sans-serif; transform: scaleX(1.05398);\">in Blender</span></span><span class=\"markedContent\" id=\"p2R_mc1\"><br role=\"presentation\"><span data-idx=\"3\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *45.75px); top: calc(var(--total-scale-factor) *138.00px); font-size: calc(var(--total-scale-factor) *16.50px); font-family: sans-serif; transform: scaleX(1.03554);\">Ziel und Forschungsfragen</span></span><span class=\"markedContent\" id=\"p2R_mc2\"><br role=\"presentation\"><span data-idx=\"5\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *45.75px); top: calc(var(--total-scale-factor) *168.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.06397);\">Ziel ist ein Blender-Generator für synthetische Risse mit exakt bekannter Breite. Mit ihm</span><br role=\"presentation\"><span data-idx=\"6\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *45.75px); top: calc(var(--total-scale-factor) *186.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.05501);\">wird gemessen, wie stark einzelne Aufnahmeeinflüsse den Breitenfehler verändern. Ein</span><br role=\"presentation\"><span data-idx=\"7\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *45.75px); top: calc(var(--total-scale-factor) *204.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.07158);\">versionierter Benchmark-Datensatz entsteht dabei als Nebenprodukt.</span></span><span class=\"markedContent\" id=\"p2R_mc3\"></span><span class=\"markedContent\" id=\"p2R_mc4\"><br role=\"presentation\"><span data-idx=\"9\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *229.43px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.0232);\">F1: Wie verändern GSD, Fokus und Blende, Blickwinkel und Licht einzeln den</span><br role=\"presentation\"><span data-idx=\"10\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *247.43px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.03837);\">Breitenfehler einer festen Messmethode, für Breiten von 0,1 bis 1,5 mm?</span></span><span class=\"markedContent\" id=\"p2R_mc5\"></span><span class=\"markedContent\" id=\"p2R_mc6\"><br role=\"presentation\"><span data-idx=\"12\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *268.43px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.06362);\">F2: Welcher Faktor dominiert im Arbeitsbereich der Stativaufnahmen (Fehlerbudget)?</span></span><span class=\"markedContent\" id=\"p2R_mc7\"></span><span class=\"markedContent\" id=\"p2R_mc8\"><br role=\"presentation\"><span data-idx=\"14\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *289.43px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.05381);\">F3: Wie gut gibt die Simulation echte Fotos eines gedruckten Testblatts wieder?</span></span><span class=\"markedContent\" id=\"p2R_mc9\"><br role=\"presentation\"><span data-idx=\"16\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *45.75px); top: calc(var(--total-scale-factor) *333.00px); font-size: calc(var(--total-scale-factor) *16.50px); font-family: sans-serif; transform: scaleX(1.06381);\">Ansatz</span></span><span class=\"markedContent\" id=\"p2R_mc10\"></span><span class=\"markedContent\" id=\"p2R_mc11\"><br role=\"presentation\"><span data-idx=\"18\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *363.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.06046);\">Geometrie: Spalten mit Geometry Nodes, erzeugt aus einer Mittellinie mit Breiten- und</span><br role=\"presentation\"><span data-idx=\"19\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *381.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.05041);\">Tiefenprofil. Verlauf, Rauigkeit und Abbrüche sind Eingänge der Node-Gruppe, jeder</span><br role=\"presentation\"><span data-idx=\"20\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *399.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.06376);\">mit Aus-Zustand.</span></span><span class=\"markedContent\" id=\"p2R_mc12\"></span><span class=\"markedContent\" id=\"p2R_mc13\"><br role=\"presentation\"><span data-idx=\"22\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *420.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.05154);\">Wahrheit: Die Breite wird an der fertigen Geometrie gemessen, nicht aus den</span><br role=\"presentation\"><span data-idx=\"23\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *438.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.04102);\">Parametern abgelesen: Schnitt mit der Oberfläche, dann Lippen, dann Sehne</span><br role=\"presentation\"><span data-idx=\"24\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *456.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.08882);\">senkrecht zur Mittellinie.</span></span><span class=\"markedContent\" id=\"p2R_mc14\"></span><span class=\"markedContent\" id=\"p2R_mc15\"><br role=\"presentation\"><span data-idx=\"26\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *477.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.02994);\">Kamera: Distanz, Fokus und Blende über die Blender-Kamera mit den Daten der Sony</span><br role=\"presentation\"><span data-idx=\"27\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *495.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.01722);\">A7R IVA. Beugung, Rauschen und JPEG kommen als einfache Stufe in Python dazu.</span></span><span class=\"markedContent\" id=\"p2R_mc16\"></span><span class=\"markedContent\" id=\"p2R_mc17\"><br role=\"presentation\"><span data-idx=\"29\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *516.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.04342);\">Ausgabe: im Format der Projekt-Pipeline: Bildausschnitt, Wahrheit je Punkt, GSD-Karte,</span><br role=\"presentation\"><span data-idx=\"30\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *62.54px); top: calc(var(--total-scale-factor) *534.68px); font-size: calc(var(--total-scale-factor) *12.00px); font-family: sans-serif; transform: scaleX(1.02426);\">Maske und Parametersatz als JSON.</span></span><span class=\"markedContent\" id=\"undefined\"><br role=\"presentation\"><span data-idx=\"32\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *45.35px); top: calc(var(--total-scale-factor) *15.34px); font-size: calc(var(--total-scale-factor) *6.00px); font-family: sans-serif; transform: scaleX(1.12142);\">Roadmap Bachelorarbeit: Synthetische Risse in Blender</span><br role=\"presentation\"><span data-idx=\"34\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" style=\"left: calc(var(--total-scale-factor) *516.97px); top: calc(var(--total-scale-factor) *821.59px); font-size: calc(var(--total-scale-factor) *6.00px); font-family: sans-serif; transform: scaleX(1.09805);\">Page 1 of 2</span></span><div class=\"endOfContent\"></div></div></div><div class=\"page\" data-page-number=\"2\" role=\"region\" data-l10n-id=\"pdfjs-page-landmark\" data-l10n-args=\"{&quot;page&quot;:2}\" style=\"width: round(down, var(--total-scale-factor) * 595.91998px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 842.88px, var(--scale-round-y));\" data-loaded=\"true\"><div class=\"canvasWrapper\"><canvas role=\"presentation\" width=\"1539\" height=\"2176\"></canvas></div><div tabindex=\"0\" class=\"textLayer\" data-main-rotation=\"0\" style=\"width: round(down, var(--total-scale-factor) * 595.91998px, var(--scale-round-x)); height: round(down, var(--total-scale-factor) * 842.88px, var(--scale-round-y));\"><span class=\"markedContent\" id=\"undefined\"></span><span class=\"markedContent\" id=\"p8R_mc0\"><span data-idx=\"0\" class=\"textLayerNode\" role=\"presentation\" dir=\"ltr\" s